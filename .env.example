# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_transport?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for session signing and authentication
JWT_SECRET=super_secret_smart_transport_jwt_key_2026_change_in_production

# Optional Map API Keys (Mapbox, Google Maps, or OpenStreetMap)
MAP_API_KEY=
NEXT_PUBLIC_MAP_API_KEY=

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
