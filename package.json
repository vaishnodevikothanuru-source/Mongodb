{
  "name": "cinevault-movie-platform",
  "version": "1.0.0",
  "description": "Advanced Full-Stack Movie Library & Personal Recommendation Platform powered by MongoDB",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/server.js",
    "start:server": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "test:crud": "node server/tests/crud_verification.test.js"
  },
  "keywords": [
    "movie-library",
    "recommendation-engine",
    "mongodb",
    "mongoose",
    "react",
    "vite",
    "nodejs",
    "express"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
