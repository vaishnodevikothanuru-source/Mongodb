NODE_ENV=development
PORT=5000

# MongoDB URI (Supports Local MongoDB, Docker MongoDB, or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/movie_library
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/movie_library?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_movie_library_2026_change_in_production
JWT_EXPIRES_IN=30d

# Client Application URL
CLIENT_URL=http://localhost:5173

# Optional: The Movie Database (TMDB) API Configuration
# If omitted or offline, the application seamlessly uses the built-in MongoDB Global Movie Catalog!
MOVIE_API_KEY=
MOVIE_API_BASE_URL=https://api.themoviedb.org/3
